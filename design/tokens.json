{
  "$description": "Design tokens del proyecto (formato W3C Design Tokens). Fuente única de verdad: tokens.css se genera con `factory tokens`. Los nombres de los tokens semánticos (color.bg, color.primary, font.family.body…) son un contrato: la galería y las maquetas dependen de ellos. Cambia los valores, no los nombres.",
  "color": {
    "palette": {
      "$description": "Colores de marca en bruto, extraídos de boadillamotor.es (azul marino del logo, #011627 del pie, azul de enlaces, coral). Los semánticos los referencian.",
      "navy-900": {
        "$type": "color",
        "$value": "#011627",
        "$description": "Azul marino muy oscuro (pie de la web actual, titulares, texto)",
        "$extensions": {
          "pantone": "PANTONE 5463 C (aprox.)",
          "cmyk": "100 80 50 80"
        }
      },
      "navy-700": {
        "$type": "color",
        "$value": "#09237a",
        "$description": "Azul marino del logotipo (marca principal)",
        "$extensions": {
          "pantone": "PANTONE 2755 C (aprox.)",
          "cmyk": "100 95 10 30"
        }
      },
      "navy-800": {
        "$type": "color",
        "$value": "#061a5c",
        "$description": "Azul marino profundo (hover)",
        "$extensions": {
          "pantone": "PANTONE 2766 C (aprox.)",
          "cmyk": "100 95 25 45"
        }
      },
      "navy-50": {
        "$type": "color",
        "$value": "#e8edf9",
        "$description": "Azul marino muy claro (fondos suaves)",
        "$extensions": {
          "pantone": "PANTONE 656 C (aprox.)",
          "cmyk": "10 6 0 0"
        }
      },
      "blue-600": {
        "$type": "color",
        "$value": "#0170b9",
        "$description": "Azul de enlaces y detalles de la web actual (secundario)",
        "$extensions": {
          "pantone": "PANTONE 7461 C (aprox.)",
          "cmyk": "90 45 0 0"
        }
      },
      "coral-400": {
        "$type": "color",
        "$value": "#f2615f",
        "$description": "Coral de acento (derivado del #d94948 de la web; sobre fondos oscuros)",
        "$extensions": {
          "pantone": "PANTONE 170 C (aprox.)",
          "cmyk": "0 75 60 0"
        }
      },
      "coral-700": {
        "$type": "color",
        "$value": "#b3302f",
        "$description": "Coral oscuro (errores y énfasis sobre fondo claro)",
        "$extensions": {
          "pantone": "PANTONE 7621 C (aprox.)",
          "cmyk": "10 95 90 15"
        }
      },
      "neutral-600": {
        "$type": "color",
        "$value": "#4b4f58",
        "$description": "Gris texto secundario (de la web actual)"
      },
      "neutral-200": {
        "$type": "color",
        "$value": "#e5e5e5",
        "$description": "Gris bordes (de la web actual)"
      },
      "neutral-50": {
        "$type": "color",
        "$value": "#f5f5f5",
        "$description": "Gris fondo (de la web actual)"
      },
      "white": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "green-700": {
        "$type": "color",
        "$value": "#0f7a3d",
        "$description": "Verde (confirmaciones y WhatsApp)"
      },
      "amber-700": {
        "$type": "color",
        "$value": "#8f5200",
        "$description": "Ámbar oscuro (avisos)"
      }
    },
    "bg": {
      "$type": "color",
      "$value": "{color.palette.neutral-50}",
      "$description": "Fondo de página",
      "$extensions": {
        "mode": {
          "dark": "#0b1220"
        }
      }
    },
    "surface": {
      "$type": "color",
      "$value": "{color.palette.white}",
      "$description": "Tarjetas y paneles",
      "$extensions": {
        "mode": {
          "dark": "#111a2e"
        }
      }
    },
    "text": {
      "$type": "color",
      "$value": "{color.palette.navy-900}",
      "$description": "Texto principal",
      "$extensions": {
        "mode": {
          "dark": "#eaf0fb"
        }
      }
    },
    "text-muted": {
      "$type": "color",
      "$value": "{color.palette.neutral-600}",
      "$description": "Texto secundario",
      "$extensions": {
        "mode": {
          "dark": "#a9b6cc"
        }
      }
    },
    "border": {
      "$type": "color",
      "$value": "{color.palette.neutral-200}",
      "$description": "Bordes y separadores",
      "$extensions": {
        "mode": {
          "dark": "#25324d"
        }
      }
    },
    "primary": {
      "$type": "color",
      "$value": "{color.palette.navy-700}",
      "$description": "Acción principal, enlaces (azul marino del logotipo)",
      "$extensions": {
        "mode": {
          "dark": "#8fb0ff"
        }
      }
    },
    "primary-strong": {
      "$type": "color",
      "$value": "{color.palette.navy-800}",
      "$description": "Hover y énfasis de la acción principal",
      "$extensions": {
        "mode": {
          "dark": "#b9cdff"
        }
      }
    },
    "primary-soft": {
      "$type": "color",
      "$value": "{color.palette.navy-50}",
      "$description": "Fondos suaves de marca (azul)",
      "$extensions": {
        "mode": {
          "dark": "#14224a"
        }
      }
    },
    "on-primary": {
      "$type": "color",
      "$value": "{color.palette.white}",
      "$description": "Texto sobre primary",
      "$extensions": {
        "mode": {
          "dark": "#02112e"
        }
      }
    },
    "accent": {
      "$type": "color",
      "$value": "{color.palette.coral-400}",
      "$description": "Detalles y avisos destacados sobre azul marino oscuro (no usar como texto sobre blanco)"
    },
    "success": {
      "$type": "color",
      "$value": "{color.palette.green-700}"
    },
    "warning": {
      "$type": "color",
      "$value": "{color.palette.amber-700}"
    },
    "danger": {
      "$type": "color",
      "$value": "{color.palette.coral-700}"
    },
    "surface-dark": {
      "$type": "color",
      "$value": "{color.palette.navy-900}",
      "$description": "Cabecera, pie y bloques azul marino oscuro",
      "$extensions": {
        "mode": {
          "dark": "#010b14"
        }
      }
    },
    "on-surface-dark": {
      "$type": "color",
      "$value": "{color.palette.white}",
      "$description": "Texto sobre surface-dark",
      "$extensions": {
        "mode": {
          "dark": "#eef1f5"
        }
      }
    },
    "on-accent": {
      "$type": "color",
      "$value": "{color.palette.navy-900}",
      "$description": "Texto sobre accent"
    },
    "whatsapp": {
      "$type": "color",
      "$value": "{color.palette.green-700}",
      "$description": "Botón de WhatsApp",
      "$extensions": {
        "mode": {
          "dark": "#3fcf7e"
        }
      }
    },
    "on-whatsapp": {
      "$type": "color",
      "$value": "{color.palette.white}",
      "$description": "Texto sobre whatsapp",
      "$extensions": {
        "mode": {
          "dark": "#04170c"
        }
      }
    },
    "secondary": {
      "$type": "color",
      "$value": "{color.palette.blue-600}",
      "$description": "Enlaces secundarios y detalles (azul de la web actual)",
      "$extensions": {
        "mode": {
          "dark": "#5eb4ee"
        }
      }
    },
    "on-secondary": {
      "$type": "color",
      "$value": "{color.palette.white}",
      "$description": "Texto sobre secondary",
      "$extensions": {
        "mode": {
          "dark": "#02112e"
        }
      }
    }
  },
  "font": {
    "family": {
      "heading": {
        "$type": "fontFamily",
        "$value": [
          "League Spartan",
          "Avenir Next",
          "Century Gothic",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "system-ui",
          "sans-serif"
        ],
        "$extensions": {
          "license": "Pila de sistema; la web actual usa League Spartan (OFL), aquí solo como preferencia si el visitante la tiene instalada (sin descarga, sin CDN)",
          "url": ""
        }
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$extensions": {
          "license": "Fuentes del sistema (sin descarga, sin terceros)",
          "url": ""
        }
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      },
      "extrabold": {
        "$type": "fontWeight",
        "$value": 800
      }
    },
    "size": {
      "$description": "Escala tipográfica (base 16px, ratio 1.25).",
      "xs": {
        "$type": "dimension",
        "$value": "0.8rem"
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.875rem"
      },
      "md": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "lg": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.563rem"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "1.953rem"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "2.441rem"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "3.052rem"
      }
    },
    "line-height": {
      "tight": {
        "$type": "number",
        "$value": 1.2
      },
      "normal": {
        "$type": "number",
        "$value": 1.55
      }
    }
  },
  "space": {
    "$description": "Escala de espaciado (base 4px).",
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    },
    "16": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "md": {
      "$type": "dimension",
      "$value": "6px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "12px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(1, 22, 39, 0.12)"
    },
    "md": {
      "$type": "shadow",
      "$value": "0 6px 16px rgba(1, 22, 39, 0.16)"
    }
  },
  "breakpoint": {
    "$description": "Anchos de ruptura (mobile first).",
    "sm": {
      "$type": "dimension",
      "$value": "640px"
    },
    "md": {
      "$type": "dimension",
      "$value": "768px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1024px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1280px"
    }
  },
  "layout": {
    "max-width": {
      "$type": "dimension",
      "$value": "1200px",
      "$description": "Ancho máximo del contenido"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Margen lateral en móvil"
    }
  },
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": "120ms"
    },
    "normal": {
      "$type": "duration",
      "$value": "200ms"
    }
  }
}